
@namespace RizzyUI
@using Blazicons
@inherits RzComponent<CommandList.Slots>

<p id="rz-command-instructions-@ParentCommand?.Id" class="sr-only">Use up and down arrow keys to navigate commands, press Enter to select, and Escape to close.</p>

<div @attributes="AdditionalAttributes"
     id="rz-command-list-@ParentCommand?.Id"
     class="@SlotClasses.GetBase()"
     data-slot="command-list"
     role="listbox"
     x-data="rzCommandList" x-load="@LoadStrategyOrNull"
     x-on:click.capture="handleItemClick"
     x-on:mouseover.throttle.10ms="handleItemHover">
    
    <div x-show="showLoading" class="flex items-center justify-center p-4" x-cloak>
        <RzSpinner Size="Size.Small" />
    </div>

    @ChildContent

</div>